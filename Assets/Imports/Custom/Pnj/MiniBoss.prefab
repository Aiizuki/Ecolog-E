  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Assets.Scripts.Pnj.MiniBoss
  lstWearableMasks: []
  maskSpawnPoint: {fileID: 0}
  pnjMovement: {fileID: 2721704492518392443}
  sentences_start:
  - Hello, old friend
  - Listen carefully, i will not reapeat myself
  - We have your family with us, you know that...
  - And we will bring you masks...
  - Sell them.
  - 'And try to get the money you owe us '
  - Don't even think about cheating us.
  - We won't be fooled twice
  - 'And you know what will append... '
  - Good luck... And don't let us down this time...
  sentences:
  - Hello again my friend
  - I have more merchandise for you...
  - Give me the money first
  successSentences:
  - Good... Very good...
  - A small dent in your debt...
  - There's a chance that you'll see your family tonight...
  - Don't disappoint us
  failureSentences:
  - Are you kidding me ?!
  - Are you trying to pull a fast one on us ?!
  - It's to late for you family my friend.
  - Start running, i'm giving you a head start
